{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "sortecerta-landing",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-25",
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		],
		"not_found_handling": "single-page-application"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sortecerta-landing-local",
			"database_id": "f6f8c304-fa39-495d-8307-d01f3899968a",
			"preview_database_id": "a59144cd-55a0-4ed1-b4de-3857776061ad",
			"migrations_dir": "migrations"
		},
		{
			"binding": "sortecerta_landing",
			"database_name": "sortecerta-landing",
			"database_id": "f6f8c304-fa39-495d-8307-d01f3899968a",
			"preview_database_id": "a59144cd-55a0-4ed1-b4de-3857776061ad"
		}
	],
	"previews": {
		"d1_databases": [
			{
				"binding": "DB",
				"database_id": "a59144cd-55a0-4ed1-b4de-3857776061ad"
			},
			{
				"binding": "sortecerta_landing",
				"database_id": "a59144cd-55a0-4ed1-b4de-3857776061ad"
			}
		]
	}
}
