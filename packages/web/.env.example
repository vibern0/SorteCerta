# SorteCerta web — env example
# Copy to .env.local and fill in.

# ─── Chain & RPC (Sepolia) ───────────────────────────────────────────────────
NEXT_PUBLIC_RPC_URL=https://rpc.sepolia.org
NEXT_PUBLIC_CHAIN_ID=11155111

# ─── Contract addresses (from packages/contracts deploy script) ──────────────
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_CONFIDENTIAL_USDC_ADDRESS=
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_PRIZE_POOL_ADDRESS=
NEXT_PUBLIC_ZAMA_SPIKE_ADDRESS=

# ─── Web3Auth (https://dashboard.web3auth.io → free client ID) ───────────────
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=

# ─── Pimlico (https://dashboard.pimlico.io → API key) ────────────────────────
NEXT_PUBLIC_PIMLICO_API_KEY=
