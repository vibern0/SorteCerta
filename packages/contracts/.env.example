# SorteCerta contracts — env example
# Copy to .env and fill in.

# Deployer private key (use a fresh testnet-only key)
PRIVATE_KEY=

# Sepolia RPC URL (Alchemy, Infura, or public https://rpc.sepolia.org)
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Circle official Sepolia USDC. Override only if Circle changes its docs.
SEPOLIA_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238

# Etherscan API key for contract verification (optional)
ETHERSCAN_API_KEY=

# Gas reporter (set to "true" to log gas costs in USD)
REPORT_GAS=false
